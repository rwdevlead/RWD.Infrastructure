# Local environment overrides loaded automatically by the root Makefile.
# Copy to `.env` (gitignored) and populate required values.
# Infrastructure, provider, and application secrets live in Infisical rather than `.env`.

# ------------------------------------------------------------------------------
# Infisical Universal Auth (Required for Terraform Infisical provider & Ansible)
# ------------------------------------------------------------------------------
# Purpose: Machine identity client ID used to authenticate with Infisical.
# Required: Yes | Default: none | Example: 00000000-0000-0000-0000-000000000000
INFISICAL_CLIENT_ID=<your-infisical-client-id>

# Purpose: Machine identity client secret paired with INFISICAL_CLIENT_ID.
# Required: Yes | Default: none | Example: infisical_secret_placeholder
INFISICAL_CLIENT_SECRET=<your-infisical-client-secret>

# Purpose: Target Infisical project ID containing infrastructure and Ansible secrets.
# Required: Yes | Default: none | Example: 00000000-0000-0000-0000-000000000000
INFISICAL_PROJECT_ID=<your-infisical-project-id>

# ------------------------------------------------------------------------------
# Terraform Proxmox Fallback Credentials (Optional)
# ------------------------------------------------------------------------------
# Purpose: Fallback default VM username passed to Proxmox Terraform variables when not set in HCP workspace.
# Required: No | Default: none | Example: ubuntu
TF_VAR_default_username=<default-vm-username>

# Purpose: Fallback default VM password passed to Proxmox Terraform variables when not set in HCP workspace.
# Required: No | Default: none | Example: change-me-local-only
TF_VAR_default_password=<default-vm-password>

# ------------------------------------------------------------------------------
# Ansible Configuration (Optional — Makefile exports this automatically)
# ------------------------------------------------------------------------------
# Purpose: Path to portable Ansible config when invoking ansible-playbook directly outside Make.
# Required: No | Default: ./iac/ansible/ansible.cfg (set by Makefile) | Example: ./iac/ansible/ansible.cfg
ANSIBLE_CONFIG=./iac/ansible/ansible.cfg
