http:
  routers:
    dashboard:
      entryPoints:
        - "websecure"
      rule: "Host(`{{ traefik_instance.domain }}`)"
      middlewares:
        - default-headers
      tls:
        certResolver: "{{ traefik_acme_resolver }}"
        domains:
          - main: "{{ traefik_acme_domain_main }}"
            sans:
{% for sans in traefik_acme_domain_sans.split(',') %}
              - "{{ sans | trim }}"
{% endfor %}
      service: api@internal
    dashboard-http:
      entryPoints:
        - "web"
      rule: "Host(`{{ traefik_instance.domain }}`)"
      middlewares:
        - https-redirectscheme
      service: api@internal
{% for pve in proxmox_instances %}
    {{ pve.name }}:
      entryPoints:
        - "web"
        - "websecure"
      rule: "Host(`{{ pve.domain }}`)"
      middlewares:
        - https-redirectscheme
        - default-headers
      tls:
        certResolver: "{{ traefik_acme_resolver }}"
        domains:
          - main: "{{ traefik_acme_domain_main }}"
            sans:
{% for sans in traefik_acme_domain_sans.split(',') %}
              - "{{ sans | trim }}"
{% endfor %}
      service: {{ pve.name }}
{% endfor %}
    pihole-prod:      
      entryPoints:
        - "websecure"
      rule: "Host(`pihole-p01.local.rwdevs.com`)"
      middlewares:
        - default-headers
        - pihole-redirect      
      tls:
        certResolver: "{{ traefik_acme_resolver }}"
      service: "pihole-prod-service"
    omv:
      entryPoints:
        - "web"
        - "websecure"
      rule: "Host(`tm.local.rwdevs.com`)"
      middlewares:
        - https-redirectscheme
        - default-headers 
      tls: 
        certResolver: "{{ traefik_acme_resolver }}"
      service: "omv-service"
    uptime-kuma-prod:      
      entryPoints:
        - "web"
        - "websecure"
      rule: "Host(`uptime-kuma-p01.local.rwdevs.com`)"
      middlewares:
        - https-redirectscheme
        - default-headers     
      tls:
        certResolver: "{{ traefik_acme_resolver }}"
        domains:
          - main: "uptime-kuma-p01.local.rwdevs.com"
      service: "uptime-kuma-prod-service"
    ha-router:
      entryPoints:
        - "websecure"
      rule: "Host(`ha.local.rwdevs.com`)"
      middlewares:
        - default-headers
      tls:
        certResolver: "{{ traefik_acme_resolver }}"
      service: "ha-service"
  services:
    pihole-prod-service:
      loadBalancer:
        servers:
          - url: "http://{{ vms['prod-docker-01'].ip }}:8888"
    omv-service:
      loadBalancer:
        servers:
          - url: "http://{{ vms['dev-omv-01'].ip }}"
    uptime-kuma-prod-service:
      loadBalancer:
        servers:
          - url: "http://{{ vms['prod-docker-01'].ip }}:3001"
    ha-service:
      loadBalancer:
        servers:
          - url: "http://{{ vms['homeassistant'].ip }}:8123"
{% for pve in proxmox_instances %}
    {{ pve.name }}:
      loadBalancer:
        servers:
          - url: "{{ pve.url }}"
        passHostHeader: true
        serversTransport: proxmox-transport
{% endfor %}  
  serversTransports:
    proxmox-transport:
      insecureSkipVerify: true
  middlewares:
    https-redirectscheme:
      redirectScheme:
        scheme: https
        permanent: true
    pihole-redirect:
      redirectRegex:
        regex: "^https://pihole-p01.local.rwdevs.com/$$"
        replacement: "https://pihole-p01.local.rwdevs.com/admin/"
    default-headers:
      headers:
        frameDeny: true
        browserXssFilter: true
        contentTypeNosniff: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: {{ traefik_hsts_max_age }}
        customFrameOptionsValue: SAMEORIGIN
        customRequestHeaders:
          X-Forwarded-Proto: https
