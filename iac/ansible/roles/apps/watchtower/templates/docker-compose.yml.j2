services:
  watchtower:
    container_name: {{ watchtower_instances[inventory_hostname].name }}
    image: {{ watchtower_image }}
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    command:
{% if watchtower_cleanup %}
      - "--cleanup"
{% endif %}
      - "--label-enable"
{% if watchtower_monitor_only %}
      - "--monitor-only"
{% endif %}
      - "--schedule"
      - "{{ watchtower_schedule }}"
    environment:
      TZ: "{{ shared_timezone }}"
      DOCKER_API_VERSION: "{{ shared_docker_api_version }}"
      WATCHTOWER_NOTIFICATIONS: "email"
      WATCHTOWER_NOTIFICATION_EMAIL_FROM: "{{ watchtower_instances[inventory_hostname].email }}"
      WATCHTOWER_NOTIFICATION_EMAIL_TO: "{{ mailrise.email }}"
      WATCHTOWER_NOTIFICATION_EMAIL_SERVER: "{{ mailrise.domain }}"
      WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT: "{{ mailrise.port | string }}"
      WATCHTOWER_HTTP_API_METRICS: "true"
      WATCHTOWER_HTTP_API_TOKEN: "${WATCHTOWER_HTTP_API_TOKEN}"
    ports:
      - "8082:8080"
    labels:
      com.centurylinklabs.watchtower.enable: "false"
    networks:
      - {{ shared_docker_network }}

networks:
  {{ shared_docker_network }}:
    external: true
