#!/bin/bash
{% set master = nut_instances[inventory_hostname] -%}
{% set master_alias = proxmox_nodes[inventory_hostname].alias -%}
# {{ nut_config_dir }}/staged_takedown.sh — Managed by Ansible (role: proxmox/nut)
# Dependency-ordered cluster shutdown driven dynamically by nut_instances:
#   - Iterates shutdown tiers 1..3
#   - Within each tier: stops non-storage VMs first, then storage VMs, then powers off slave nodes assigned to that tier
#   - Local VMs on {{ master_alias }}({{ inventory_hostname }}) use `qm` directly; remote slave VMs use SSH

LOGFILE="{{ nut_takedown_log }}"
# Record outage marker so nut-bringup.service triggers staged VM recovery after power returns
touch {{ nut_outage_flag_file }}

echo "=== $(date) - Initiating Staged Takedown Sequence ===" | tee -a "$LOGFILE"

echo -e "Subject: UPS Alert\r\n\r\n⚠️ UPS on battery. Commencing graceful shutdown sequence." | \
  curl -s --url "{{ master.notifications.mailrise_url }}" --mail-from "{{ master.notifications.mail_from }}" --mail-rcpt "{{ master.notifications.mail_recipient }}" -T - || echo "Mailrise alert failed." | tee -a "$LOGFILE"
{% for tier in [1, 2, 3] %}

echo "Phase {{ tier }}: Shutting down Tier {{ tier }}..." | tee -a "$LOGFILE"
# Stop NFS-dependent VMs (false) before storage VMs (true) within the same tier to avoid hung mounts
{% for is_storage_pass in [false, true] %}
{% for node_name, node in nut_instances.items() %}
{% set node_ip = proxmox_nodes[node_name].ip %}
{% set node_alias = proxmox_nodes[node_name].alias %}
{% set is_local = (node_name == inventory_hostname) %}
{% for vm in node.vms | default([]) if vm.shutdown_tier == tier and (vm.is_storage | default(false)) == is_storage_pass %}
{% set vm_id = vms[vm.name].vm_id %}
{% if is_storage_pass %}
echo "Shutting down {{ vm.name }} ({{ vm_id }}) on {{ node_alias }}({{ node_name }})..." | tee -a "$LOGFILE"
{% endif %}
{% if is_local %}
qm shutdown {{ vm_id }} # {{ node_alias }}({{ node_name }}): {{ vm.name }}
{% else %}
ssh -o ConnectTimeout={{ nut_ssh_connect_timeout }} root@{{ node_ip }} "qm shutdown {{ vm_id }}" # {{ node_alias }}({{ node_name }}): {{ vm.name }}
{% endif %}
{% if vm.wait_for_stop | default(false) %}
echo "Waiting for {{ node_alias }}({{ node_name }}) {{ vm.name }} ({{ vm_id }}) to cleanly exit..." | tee -a "$LOGFILE"
{% if is_local %}
while [ "$(qm status {{ vm_id }} 2>/dev/null)" == "status: running" ]; do
    sleep 3
done
{% else %}
while [ "$(ssh -o ConnectTimeout={{ nut_ssh_connect_timeout }} root@{{ node_ip }} 'qm status {{ vm_id }} 2>/dev/null')" == "status: running" ]; do
    sleep 3
done
{% endif %}
echo "{{ node_alias }}({{ node_name }}) {{ vm.name }} stopped successfully." | tee -a "$LOGFILE"
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% for node_name, node in nut_instances.items() if node.role == 'slave' and (node.poweroff_tier | default(0)) == tier %}
echo "Powering off {{ proxmox_nodes[node_name].alias }}({{ node_name }}) host..." | tee -a "$LOGFILE"
ssh -o ConnectTimeout={{ nut_ssh_connect_timeout }} root@{{ proxmox_nodes[node_name].ip }} "{{ nut_shutdown_cmd }}"
{% endfor %}
{% endfor %}

echo "=== $(date) - Takedown Sequence Complete ===" | tee -a "$LOGFILE"

# Force slave shutdown and set POWERDOWNFLAG so the UPS cuts load power after FINALDELAY
/sbin/upsmon -c fsd
