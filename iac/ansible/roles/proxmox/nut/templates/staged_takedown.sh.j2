{% set master = nut_instances[inventory_hostname] %}
#!/bin/bash
# {{ nut_config_dir }}/staged_takedown.sh — Managed by Ansible (role: proxmox/nut)
# Dependency-ordered cluster shutdown driven dynamically by nut_instances:
#   - Iterates shutdown tiers 1..3
#   - Within each tier: stops non-storage VMs first, then storage VMs, then powers off slave nodes assigned to that tier
#   - Local VMs on {{ master.alias }}({{ inventory_hostname }}) use `qm` directly; remote slave VMs use SSH

LOGFILE="{{ nut_takedown_log }}"
touch {{ nut_outage_flag_file }}

echo "=== $(date) - Initiating Staged Takedown Sequence ===" | tee -a "$LOGFILE"

# Send Mailrise Alert via SMTP
echo -e "Subject: UPS Alert\r\n\r\n⚠️ UPS on battery. Commencing graceful shutdown sequence." | \
  curl -s --url "{{ master.notifications.mailrise_url }}" --mail-from "{{ master.notifications.mail_from }}" --mail-rcpt "{{ master.notifications.mail_recipient }}" -T - || echo "Mailrise alert failed." | tee -a "$LOGFILE"
{% for tier in [1, 2, 3] %}

# Phase {{ tier }}
echo "Phase {{ tier }}: Shutting down Tier {{ tier }}..." | tee -a "$LOGFILE"
{% for is_storage_pass in [false, true] %}
{% for node_name, node in nut_instances.items() %}
{% set node_ip = hostvars[node_name].ansible_host %}
{% set is_local = (node_name == inventory_hostname) %}
{% for vm in node.vms | default([]) if vm.shutdown_tier == tier and (vm.is_storage | default(false)) == is_storage_pass %}
{% if is_storage_pass %}
echo "Shutting down {{ vm.name }} ({{ vm.id }}) on {{ node.alias }}({{ node_name }})..." | tee -a "$LOGFILE"
{% endif %}
{% if is_local %}
qm shutdown {{ vm.id }} # {{ node.alias }}({{ node_name }}): {{ vm.name }}
{% else %}
ssh -o ConnectTimeout={{ nut_ssh_connect_timeout }} root@{{ node_ip }} "qm shutdown {{ vm.id }}" # {{ node.alias }}({{ node_name }}): {{ vm.name }}
{% endif %}
{% if vm.wait_for_stop | default(false) %}
echo "Waiting for {{ node.alias }}({{ node_name }}) {{ vm.name }} ({{ vm.id }}) to cleanly exit..." | tee -a "$LOGFILE"
{% if is_local %}
while [ "$(qm status {{ vm.id }} 2>/dev/null)" == "status: running" ]; do
    sleep 3
done
{% else %}
while [ "$(ssh -o ConnectTimeout={{ nut_ssh_connect_timeout }} root@{{ node_ip }} 'qm status {{ vm.id }} 2>/dev/null')" == "status: running" ]; do
    sleep 3
done
{% endif %}
echo "{{ node.alias }}({{ node_name }}) {{ vm.name }} stopped successfully." | tee -a "$LOGFILE"
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% for node_name, node in nut_instances.items() if node.role == 'slave' and (node.poweroff_tier | default(0)) == tier %}
echo "Powering off {{ node.alias }}({{ node_name }}) host..." | tee -a "$LOGFILE"
ssh -o ConnectTimeout={{ nut_ssh_connect_timeout }} root@{{ hostvars[node_name].ansible_host }} "{{ nut_shutdown_cmd }}"
{% endfor %}
{% endfor %}

echo "=== $(date) - Takedown Sequence Complete ===" | tee -a "$LOGFILE"

# Signal NUT master shutdown
/sbin/upsmon -c fsd
